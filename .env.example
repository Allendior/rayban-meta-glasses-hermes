# Phone -> bridge authentication. Generate with: openssl rand -hex 32
BRIDGE_API_KEY=replace-with-a-long-random-value

# Bind to 127.0.0.1 for local testing. For phone access, use the Mac's
# Tailscale IPv4 address rather than 0.0.0.0.
BRIDGE_HOST=127.0.0.1
# The target Mac uses 8788 because another local service already owns 8787.
BRIDGE_PORT=8788

# Bridge -> Hermes. Hermes should remain loopback-only.
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-the-key-configured-in-hermes

# Built-in transport fallback. Supports en, hi, and fr but does not clone.
TTS_PROVIDER=macos
TTS_VOICE_EN=Samantha
TTS_VOICE_HI=Lekha
TTS_VOICE_FR=Thomas

# For your cloned voice, switch to command and configure these values.
TTS_REFERENCE_AUDIO=
TTS_COMMAND=
# Optional persistent cloned-voice worker. It loads the model once and reuses it.
TTS_WORKER_COMMAND=

# Used by scripts/chatterbox_tts.py when TTS_PROVIDER=command.
CHATTERBOX_MODEL=mlx-community/chatterbox-multilingual-v3
CHATTERBOX_MODEL_REVISION=03565773edd72e949572557597af8063bb49a18a
HF_HOME=work/voice-models

# Local transcription command. It must create {output_file} containing text.
STT_COMMAND=

# Generated audio is temporary and is deleted after this many seconds.
AUDIO_TTL_SECONDS=3600

# Bound expensive Hermes/STT/TTS work and user-supplied text.
MAX_CONCURRENT_REQUESTS=2
MAX_TEXT_CHARS=2000
